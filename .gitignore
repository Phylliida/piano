# Local tool state
.nixhome/
__pycache__/
*.pyc
pcb/tile-backups/
pcb/fp-info-cache
*.lck
*.kicad_prl
# DRC and ERC reports: the generators rewrite them on every run
pcb/*.drc.json
pcb/*.erc.json
hub/*.drc.json
hub/*.erc.json

# Other people's repositories, cloned for reference (refs/README.md lists them)
refs/*
!refs/README.md

# Raw web scrapes and the browser profile that made them; the two summaries stay
research/*
!research/magnetic_switch_prices.csv
!research/pcb_fab_quotes.md

# Scratch from the first designs
work/

# Vendor datasheets
*.pdf
*.PDF

# Firmware: build output, and the two outside libraries that
# firmware/tools/fetch_deps.sh downloads
firmware/build/
firmware/deps/
